# Copy this file to .env (locally) or paste these keys in the Railway "Variables" tab.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_SERVER_ID=your_guild_id_here

# === Tickets AI (Claude) ===
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-5
TICKET_CHANNEL_PREFIX=ticket-

# Discord user ID who gets pinged when the AI escalates (you).
OWNER_USER_ID=your_discord_user_id_here

# Optional: also ping this role on escalation.
STAFF_ROLE_ID=

# === AdsPower TOTP (optional; posts “Get the code” in a channel on bot startup) ===
# DISCORD_ADSPOWER_OTP_CHANNEL_ID=1262357372970467451
# DISCORD_ADSPOWER_AUTHENTICATOR_SECRET=your_base32_totp_secret
# DISCORD_ADSPOWER_TOTP_MIN_VALID_SEC=20

# === Log Discord “Get the code” into the Next app (optional) ===
# Same ACTIVITY_TRACK_BOT_SECRET on Vercel (Next) and here (Railway). Full URL to /api/activity/track-event.
# ACTIVITY_TRACK_URL=https://your-production-domain.com/api/activity/track-event
# ACTIVITY_TRACK_BOT_SECRET=long_random_shared_secret

# === Dashboard ===
# Railway sets PORT automatically. Locally, default is 1500.
PORT=1500

# Username will always be "admin". Set a strong password before exposing the dashboard.
DASHBOARD_PASSWORD=set_a_strong_password_here

# === Persistence (Railway only) ===
# When using a Railway Volume, set this to the volume mount path (e.g. /app/data).
# Leave empty for local dev.
# DATA_DIRECTORY=/app/data
