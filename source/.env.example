# Copy this file to .env (locally) or paste these keys in the Railway "Variables" tab.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_SERVER_ID=your_guild_id_here

# === Tickets AI ===
# Option 1: OpenAI (recommended if you have credits)
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Anthropic Claude (alternative)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUDE_MODEL=claude-3-5-haiku-20241022

# Auto-detects: if OPENAI_API_KEY exists, uses OpenAI; otherwise uses Anthropic
# Or force one: AI_PROVIDER=openai or AI_PROVIDER=anthropic

TICKET_CHANNEL_PREFIX=ticket-

# Discord user ID who gets pinged when the AI escalates (you).
OWNER_USER_ID=your_discord_user_id_here

# Content panel: reviewer added to every content thread and pinged in the info channel
# (defaults: OWNER_USER_ID and channel 1556165339413352518).
CONTENT_REVIEWER_ID=
CONTENT_INFO_CHANNEL_ID=

# Optional: also ping this role on escalation.
STAFF_ROLE_ID=

# === AI Support Agent (general chat monitoring) ===
# Channel where low-confidence questions are reported for staff review
AI_AGENT_STAFF_ALERT_CHANNEL_ID=your_staff_channel_id_here

# Optional: override the Discord role id used for the Ecom Agent cancellation warning.
ECOM_AGENT_ROLE_ID=1244916325294542858

# === AdsPower TOTP (optional; posts “Get the code” in a channel on bot startup) ===
# DISCORD_ADSPOWER_OTP_CHANNEL_ID=1262357372970467451
# DISCORD_ADSPOWER_AUTHENTICATOR_SECRET=your_base32_totp_secret
# DISCORD_ADSPOWER_TOTP_MIN_VALID_SEC=20

# === Log Discord “Get the code” into the Next app (optional) ===
# Same ACTIVITY_TRACK_BOT_SECRET on Vercel (Next) and here (Railway). Full URL to /api/activity/track-event.
# Each button click POSTs adspower_discord_totp_request with discord_display, discord_username (handle), user id, outcome, clicked_at.
# ACTIVITY_TRACK_URL=https://your-production-domain.com/api/activity/track-event
# ACTIVITY_TRACK_BOT_SECRET=long_random_shared_secret

# === Ghost agent audit (/audit-cancelled-agents) ===
# Legacy Sublaunch Stripe + Supabase (optional, improves email matching).
STRIPE_SECRET_KEY_LEGACY=sk_live_your_legacy_stripe_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# === Dashboard ===
# Railway sets PORT automatically. Locally, default is 1500.
PORT=1500

# Username will always be "admin". Set a strong password before exposing the dashboard.
DASHBOARD_PASSWORD=set_a_strong_password_here

# === Persistence (Railway only) ===
# When using a Railway Volume, set this to the volume mount path (e.g. /app/data).
# Leave empty for local dev.
# DATA_DIRECTORY=/app/data

# === Storage Optimization ===
# Content files directory (mounted Railway volume)
# CONTENT_FILES_DIR=/data/content-files

# Railway volume size in GB (default: 5)
# VOLUME_SIZE_GB=5

# Content file retention in days (default: 5, was 14)
# Files older than this are automatically deleted
# Reduced to 5 days to prevent disk full errors
# Set to 3 for aggressive cleanup if hitting storage limits
# CONTENT_FILE_TTL_DAYS=5
