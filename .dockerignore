# Build / source control
.git
.github
.gitignore
.gitattributes

# Local dependencies — must be re-installed in the container for the right arch
**/node_modules

# Secrets — must be passed as Railway env vars, never baked into the image
**/.env
**/.env.local
**/.env.*.local

# Runtime data — regenerated by the bot at runtime
source/data/tickets-history.json
source/data/server-knowledge.md
source/data/server-knowledge.meta.json

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db
desktop.ini

# Backups / archives
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# Docs / meta — not needed inside the image
README.md
.cursor
